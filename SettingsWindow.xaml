<Window x:Class="PrintBatcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:PrintBatcher.Models"
        xmlns:conv="clr-namespace:PrintBatcher.Converters"
        Title="Ayarlar" Height="460" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F3F5F8">
    <Window.Resources>
        <conv:EnumDisplayConverter x:Key="EnumDisplay" />

        <ObjectDataProvider x:Key="ColorModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ColorMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="OrientationValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:PageOrientation" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="DuplexValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:DuplexMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ScaleModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ScaleMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="190" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="Grid" x:Key="FieldGrid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Button DockPanel.Dock="Bottom" Content="Kapat" HorizontalAlignment="Right" Padding="14,6" Margin="0,14,0,0"
                Click="CloseButton_Click" IsDefault="True" />

        <TabControl>
            <!-- ===== Genel ===== -->
            <TabItem Header="Genel">
                <StackPanel Margin="12">
                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Varsayılan kopya sayısı" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                 Text="{Binding DefaultCopies, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Belgeler arası bekleme (ms)" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                 Text="{Binding WaitBeforeEachDocumentMs, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <TextBlock Text="Atlanacak dosya maskesi (; ile ayırın)" Margin="0,4,0,4" />
                    <TextBox Text="{Binding SkipFilesMask, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                    <CheckBox Content="Yazdırmadan önce onay iste" IsChecked="{Binding ConfirmBeforePrinting}" />
                    <CheckBox Content="Hatalı dosyaları atlayıp devam et" IsChecked="{Binding SkipFilesWithErrors}" />
                    <CheckBox Content="Yazdırılan öğeleri listeden kaldır" IsChecked="{Binding RemovePrintedFromList}" />
                    <CheckBox Content="Yazdırma bitince listeyi temizle" IsChecked="{Binding ClearListAfterPrinting}" />
                </StackPanel>
            </TabItem>

            <!-- ===== Yazdırma ===== -->
            <TabItem Header="Yazdırma">
                <StackPanel Margin="12">
                    <TextBlock Text="Bu sekmedeki ayarlar yalnızca doğrudan işlenen görsel dosyalarda (jpg, png, bmp, tiff…) uygulanır. Diğer formatlar yazıcının güncel sürücü varsayılanlarını kullanır."
                               TextWrapping="Wrap" Foreground="#6B7684" FontSize="11" Margin="0,0,0,14" />

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Renk modu" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource ColorModeValues}}"
                                  SelectedItem="{Binding ColorMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kağıt yönü" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource OrientationValues}}"
                                  SelectedItem="{Binding Orientation}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Çift taraflı" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource DuplexValues}}"
                                  SelectedItem="{Binding Duplex}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ölçekleme" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource ScaleModeValues}}"
                                  SelectedItem="{Binding ScaleMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource FieldGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Özel oran (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Width="60" HorizontalAlignment="Left"
                                 Text="{Binding CustomScalePercent, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <CheckBox Content="Harmanla (collate)" IsChecked="{Binding Collate}" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>

            <!-- ===== Arayüz ===== -->
            <TabItem Header="Arayüz">
                <StackPanel Margin="12">
                    <CheckBox Content="Son kullanılan yazıcıyı hatırla" IsChecked="{Binding RememberLastPrinter}" />
                    <CheckBox Content="Uygulama açılırken son oturumu geri yükle" IsChecked="{Binding RestoreLastSession}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
