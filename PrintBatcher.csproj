<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\PrintBatcher.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>PrintBatcher</AssemblyTitle>
    <Product>PrintBatcher</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\PrintBatcher.ico" />
  </ItemGroup>

</Project>
